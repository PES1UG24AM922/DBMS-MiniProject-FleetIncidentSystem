# Copy to .env.local. These values match db/rbac.sql - change both for real deployments.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=transport_db
DB_AUTH_USER=app_auth
DB_AUTH_PASS=CHANGE_ME_auth
DB_ADMIN_USER=app_admin
DB_ADMIN_PASS=CHANGE_ME_admin
DB_MANAGER_USER=app_manager
DB_MANAGER_PASS=CHANGE_ME_manager
DB_DRIVER_USER=app_driver
DB_DRIVER_PASS=CHANGE_ME_driver
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=transport_nosql
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
